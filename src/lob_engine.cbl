*>================================================================*
*> PROGRAM-ID.    LOB-ENGINE.
*> AUTHOR.        KRISTJAN.
*> DATE-WRITTEN.  2022-04-10.
*> PURPOSE.       HIGH-FREQUENCY LIMIT ORDER BOOK & MATCHING ENGINE
*>                - EXACT FIXED-POINT DECIMAL PRICING (COMP-3)
*>                - NATIVE BINARY TIMESTAMPS & QUANTITIES (COMP-5)
*>                - PRICE-TIME PRIORITY (FIFO) QUEUES
*>                - LIMIT, MARKET, STOP-LOSS, IOC ORDER ROUTING
*>                - ISAM PERSISTENT SNAPSHOT STATE RECOVERY
*>================================================================*
IDENTIFICATION DIVISION.
PROGRAM-ID. LOB-ENGINE.

ENVIRONMENT DIVISION.
CONFIGURATION SECTION.
SPECIAL-NAMES.
    DECIMAL-POINT IS COMMA.

INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT OPTIONAL SNAPSHOT-FILE
        ASSIGN TO "lob_snapshot.dat"
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS SNAP-ORDER-ID
        FILE STATUS IS WS-SNAP-STATUS.

DATA DIVISION.
FILE SECTION.
FD  SNAPSHOT-FILE.
COPY "SNAP-RECORD.cpy".

WORKING-STORAGE SECTION.
COPY "ORDER-RECORD.cpy".
COPY "TRADE-RECORD.cpy".
COPY "BOOK-CONFIG.cpy".

01  WS-SYSTEM-VARS.
    05  WS-SNAP-STATUS          PIC X(2) VALUE "00".
    05  WS-NEXT-ORDER-ID        PIC 9(9) COMP-5 VALUE 1000.
    05  WS-NEXT-TRADE-ID        PIC 9(9) COMP-5 VALUE 5000.
    05  WS-TIMESTAMP-CTR        PIC 9(16) COMP-5 VALUE 1647338400000.
    05  WS-ACTIVE-ORDERS        PIC 9(4) COMP-5 VALUE 0.
    05  WS-LAST-TRADE-PRICE     PIC S9(9)V9(4) COMP-3 VALUE 0.
    05  WS-TOTAL-VOLUME         PIC 9(9) COMP-5 VALUE 0.
    05  WS-TOTAL-TRADES         PIC 9(4) COMP-5 VALUE 0.
    05  WS-BOOK-SYMBOL          PIC X(8) VALUE "ESTX-50".

*> Order Table Storage
01  ORDER-BOOK-DATA.
    05  ORD-COUNT               PIC 9(4) COMP-5 VALUE 0.
    05  BOOK-ORDERS OCCURS 500 TIMES.
        10  BK-ID               PIC 9(9) COMP-5.
        10  BK-CLIENT-ID        PIC X(8).
        10  BK-SYMBOL           PIC X(8).
        10  BK-SIDE             PIC X.
        10  BK-TYPE             PIC X.
        10  BK-PRICE            PIC S9(9)V9(4) COMP-3.
        10  BK-STOP-PRICE       PIC S9(9)V9(4) COMP-3.
        10  BK-QTY              PIC 9(8) COMP-5.
        10  BK-FILLED-QTY       PIC 9(8) COMP-5.
        10  BK-LEAVES-QTY       PIC 9(8) COMP-5.
        10  BK-STATUS           PIC X.
        10  BK-TIMESTAMP        PIC 9(16) COMP-5.

*> Bid Levels (Sorted Descending)
01  BIDS-LADDER.
    05  BID-COUNT               PIC 9(4) COMP-5 VALUE 0.
    05  BID-LEVELS OCCURS 50 TIMES.
        10  BID-PRICE           PIC S9(9)V9(4) COMP-3.
        10  BID-TOTAL-QTY       PIC 9(8) COMP-5.
        10  BID-ORD-COUNT       PIC 9(4) COMP-5.
        10  BID-ORD-IDS OCCURS 50 TIMES PIC 9(9) COMP-5.

*> Ask Levels (Sorted Ascending)
01  ASKS-LADDER.
    05  ASK-COUNT               PIC 9(4) COMP-5 VALUE 0.
    05  ASK-LEVELS OCCURS 50 TIMES.
        10  ASK-PRICE           PIC S9(9)V9(4) COMP-3.
        10  ASK-TOTAL-QTY       PIC 9(8) COMP-5.
        10  ASK-ORD-COUNT       PIC 9(4) COMP-5.
        10  ASK-ORD-IDS OCCURS 50 TIMES PIC 9(9) COMP-5.

*> Stop Orders Queue
01  STOPS-LADDER.
    05  STOP-COUNT              PIC 9(4) COMP-5 VALUE 0.
    05  STOP-ORD-IDS OCCURS 50 TIMES PIC 9(9) COMP-5.

*> Temporary Processing Variables
01  WS-WORK-VARS.
    05  WS-CANCEL-ID            PIC 9(9) COMP-5.
    05  WS-IDX                  PIC 9(4) COMP-5.
    05  WS-JDX                  PIC 9(4) COMP-5.
    05  WS-KDX                  PIC 9(4) COMP-5.
    05  WS-RESTING-IDX          PIC 9(4) COMP-5.
    05  WS-RESTING-ID           PIC 9(9) COMP-5.
    05  WS-MATCH-QTY            PIC 9(8) COMP-5.
    05  WS-MATCH-PRICE          PIC S9(9)V9(4) COMP-3.
    05  WS-INSERTED             PIC X VALUE "N".
    05  WS-SPREAD               PIC S9(9)V9(4) COMP-3 VALUE 0.

*> Display Formatting Fields
01  WS-DISPLAY-FIELDS.
    05  DISP-PRICE              PIC --.---.--9,9999.
    05  DISP-STOP               PIC --.---.--9,9999.
    05  DISP-SPREAD             PIC --.---.--9,9999.
    05  DISP-QTY                PIC ZZ.ZZZ.ZZ9.
    05  DISP-TRADE-ID           PIC 9(5).
    05  DISP-ORD-ID             PIC 9(5).
    05  DISP-BUY-ID             PIC 9(5).
    05  DISP-SELL-ID            PIC 9(5).
    05  DISP-COUNT              PIC Z.ZZ9.

PROCEDURE DIVISION.
0000-MAIN.
    DISPLAY "==================================================".
    DISPLAY "  BALTIC HIGH-FREQUENCY LIMIT ORDER BOOK (LOB)    ".
    DISPLAY "  STANDALONE MATCHING ENGINE TEST RUNNER          ".
    DISPLAY "==================================================".
    PERFORM 1000-INITIALIZE.
    PERFORM 2000-RUN-SIMULATION-SCENARIO.
    PERFORM 3000-TEST-PERSISTENCE.
    DISPLAY "==================================================".
    DISPLAY "  LOB ENGINE RUN COMPLETED SUCCESSFULLY           ".
    DISPLAY "==================================================".
    STOP RUN.

1000-INITIALIZE.
    INITIALIZE ORDER-BOOK-DATA.
    INITIALIZE BIDS-LADDER.
    INITIALIZE ASKS-LADDER.
    INITIALIZE STOPS-LADDER.
    MOVE 0 TO WS-ACTIVE-ORDERS.
    MOVE 0 TO WS-LAST-TRADE-PRICE.
    MOVE 0 TO WS-TOTAL-VOLUME.
    MOVE 0 TO WS-TOTAL-TRADES.
    MOVE 1000 TO WS-NEXT-ORDER-ID.
    MOVE 5000 TO WS-NEXT-TRADE-ID.

2000-RUN-SIMULATION-SCENARIO.
    DISPLAY " ".
    DISPLAY "--- STAGE 1: SEEDING INITIAL LIQUIDITY LADDER ---".
*> Limit Buy 100,20 Qty 500 (ID 1001)
    PERFORM 2100-NEW-TIMESTAMP.
    MOVE "CL01"     TO ORD-CLIENT-ID.
    MOVE "ESTX-50"  TO ORD-SYMBOL.
    MOVE "B"        TO ORD-SIDE.
    MOVE "L"        TO ORD-TYPE.
    MOVE 100,2000   TO ORD-PRICE.
    MOVE 0          TO ORD-STOP-PRICE.
    MOVE 500        TO ORD-QTY.
    PERFORM 5000-SUBMIT-ORDER.

*> Second Limit Buy at 100,20 Qty 100 (exercises same-level BID queue append)
    PERFORM 2100-NEW-TIMESTAMP.
    MOVE "CL01B"    TO ORD-CLIENT-ID.
    MOVE "ESTX-50"  TO ORD-SYMBOL.
    MOVE "B"        TO ORD-SIDE.
    MOVE "L"        TO ORD-TYPE.
    MOVE 100,2000   TO ORD-PRICE.
    MOVE 0          TO ORD-STOP-PRICE.
    MOVE 100        TO ORD-QTY.
    PERFORM 5000-SUBMIT-ORDER.

*> Limit Buy 100,25 Qty 300
    PERFORM 2100-NEW-TIMESTAMP.
    MOVE "CL02"     TO ORD-CLIENT-ID.
    MOVE "ESTX-50"  TO ORD-SYMBOL.
    MOVE "B"        TO ORD-SIDE.
    MOVE "L"        TO ORD-TYPE.
    MOVE 100,2500   TO ORD-PRICE.
    MOVE 0          TO ORD-STOP-PRICE.
    MOVE 300        TO ORD-QTY.
    PERFORM 5000-SUBMIT-ORDER.

*> Limit Buy 100,15 Qty 400
    PERFORM 2100-NEW-TIMESTAMP.
    MOVE "CL03"     TO ORD-CLIENT-ID.
    MOVE "ESTX-50"  TO ORD-SYMBOL.
    MOVE "B"        TO ORD-SIDE.
    MOVE "L"        TO ORD-TYPE.
    MOVE 100,1500   TO ORD-PRICE.
    MOVE 0          TO ORD-STOP-PRICE.
    MOVE 400        TO ORD-QTY.
    PERFORM 5000-SUBMIT-ORDER.

*> Limit Sell 100,35 Qty 350 (seeded before 100,30 to test ask price insertion sort)
    PERFORM 2100-NEW-TIMESTAMP.
    MOVE "CL05"     TO ORD-CLIENT-ID.
    MOVE "ESTX-50"  TO ORD-SYMBOL.
    MOVE "S"        TO ORD-SIDE.
    MOVE "L"        TO ORD-TYPE.
    MOVE 100,3500   TO ORD-PRICE.
    MOVE 0          TO ORD-STOP-PRICE.
    MOVE 350        TO ORD-QTY.
    PERFORM 5000-SUBMIT-ORDER.

*> Limit Sell 100,30 Qty 200 (triggers ask level shift right)
    PERFORM 2100-NEW-TIMESTAMP.
    MOVE "CL04"     TO ORD-CLIENT-ID.
    MOVE "ESTX-50"  TO ORD-SYMBOL.
    MOVE "S"        TO ORD-SIDE.
    MOVE "L"        TO ORD-TYPE.
    MOVE 100,3000   TO ORD-PRICE.
    MOVE 0          TO ORD-STOP-PRICE.
    MOVE 200        TO ORD-QTY.
    PERFORM 5000-SUBMIT-ORDER.

*> Second Limit Sell at 100,30 Qty 100 (exercises same-level ASK queue append)
    PERFORM 2100-NEW-TIMESTAMP.
    MOVE "CL04B"    TO ORD-CLIENT-ID.
    MOVE "ESTX-50"  TO ORD-SYMBOL.
    MOVE "S"        TO ORD-SIDE.
    MOVE "L"        TO ORD-TYPE.
    MOVE 100,3000   TO ORD-PRICE.
    MOVE 0          TO ORD-STOP-PRICE.
    MOVE 100        TO ORD-QTY.
    PERFORM 5000-SUBMIT-ORDER.

*> Limit Sell 100,40 Qty 600
    PERFORM 2100-NEW-TIMESTAMP.
    MOVE "CL06"     TO ORD-CLIENT-ID.
    MOVE "ESTX-50"  TO ORD-SYMBOL.
    MOVE "S"        TO ORD-SIDE.
    MOVE "L"        TO ORD-TYPE.
    MOVE 100,4000   TO ORD-PRICE.
    MOVE 0          TO ORD-STOP-PRICE.
    MOVE 600        TO ORD-QTY.
    PERFORM 5000-SUBMIT-ORDER.

    PERFORM 8000-PRINT-DEPTH-LADDER.

    DISPLAY " ".
    DISPLAY "--- STAGE 2: MARKET ORDER CROSSING MULTIPLE LEVELS ---".
*> Market Buy 250 (consumes 200 @ 100,30, shifts ask FIFO queue, then takes 50 @ 100,30)
    PERFORM 2100-NEW-TIMESTAMP.
    MOVE "CL07"     TO ORD-CLIENT-ID.
    MOVE "ESTX-50"  TO ORD-SYMBOL.
    MOVE "B"        TO ORD-SIDE.
    MOVE "M"        TO ORD-TYPE.
    MOVE 0          TO ORD-PRICE.
    MOVE 0          TO ORD-STOP-PRICE.
    MOVE 250        TO ORD-QTY.
    PERFORM 5000-SUBMIT-ORDER.

    PERFORM 8000-PRINT-DEPTH-LADDER.

    DISPLAY " ".
    DISPLAY "--- STAGE 3: IMMEDIATE-OR-CANCEL (IOC) ORDER ---".
*> IOC Buy 400 @ 100,30 (only 50 available @ 100,30; remainder 350 cancels)
    PERFORM 2100-NEW-TIMESTAMP.
    MOVE "CL08"     TO ORD-CLIENT-ID.
    MOVE "ESTX-50"  TO ORD-SYMBOL.
    MOVE "B"        TO ORD-SIDE.
    MOVE "I"        TO ORD-TYPE.
    MOVE 100,3000   TO ORD-PRICE.
    MOVE 0          TO ORD-STOP-PRICE.
    MOVE 400        TO ORD-QTY.
    PERFORM 5000-SUBMIT-ORDER.

    PERFORM 8000-PRINT-DEPTH-LADDER.

    DISPLAY " ".
    DISPLAY "--- STAGE 3.5: CLIENT ORDER CANCELLATION ---".
*> Cancel a resting Buy order (Order 1004)
    MOVE 1004 TO WS-CANCEL-ID.
    PERFORM 2900-CANCEL-ORDER-BY-ID.
*> Cancel a resting Sell order (Order 1008)
    MOVE 1008 TO WS-CANCEL-ID.
    PERFORM 2900-CANCEL-ORDER-BY-ID.
    PERFORM 8000-PRINT-DEPTH-LADDER.

    DISPLAY " ".
    DISPLAY "--- STAGE 4: STOP-LOSS PLACEMENT & TRIGGERING ---".
*> Register Stop-Loss Sell 1 with stop price 100,20
    PERFORM 2100-NEW-TIMESTAMP.
    MOVE "CL09A"    TO ORD-CLIENT-ID.
    MOVE "ESTX-50"  TO ORD-SYMBOL.
    MOVE "S"        TO ORD-SIDE.
    MOVE "S"        TO ORD-TYPE.
    MOVE 0          TO ORD-PRICE.
    MOVE 100,2000   TO ORD-STOP-PRICE.
    MOVE 250        TO ORD-QTY.
    PERFORM 5000-SUBMIT-ORDER.

*> Register Stop-Loss Sell 2 with stop price 100,10 (tests queue shift and non-triggered check)
    PERFORM 2100-NEW-TIMESTAMP.
    MOVE "CL09B"    TO ORD-CLIENT-ID.
    MOVE "ESTX-50"  TO ORD-SYMBOL.
    MOVE "S"        TO ORD-SIDE.
    MOVE "S"        TO ORD-TYPE.
    MOVE 0          TO ORD-PRICE.
    MOVE 100,1000   TO ORD-STOP-PRICE.
    MOVE 200        TO ORD-QTY.
    PERFORM 5000-SUBMIT-ORDER.

*> Place Market Sell 400 (hits 100,25 for 300 and 100,20 for 100, triggering 100,20 stop)
    PERFORM 2100-NEW-TIMESTAMP.
    MOVE "CL10"     TO ORD-CLIENT-ID.
    MOVE "ESTX-50"  TO ORD-SYMBOL.
    MOVE "S"        TO ORD-SIDE.
    MOVE "M"        TO ORD-TYPE.
    MOVE 0          TO ORD-PRICE.
    MOVE 0          TO ORD-STOP-PRICE.
    MOVE 400        TO ORD-QTY.
    PERFORM 5000-SUBMIT-ORDER.

*> Place Market Sell 150 (completely fills first order at 100,20, triggering BID queue shift)
    PERFORM 2100-NEW-TIMESTAMP.
    MOVE "CL10B"    TO ORD-CLIENT-ID.
    MOVE "ESTX-50"  TO ORD-SYMBOL.
    MOVE "S"        TO ORD-SIDE.
    MOVE "M"        TO ORD-TYPE.
    MOVE 0          TO ORD-PRICE.
    MOVE 0          TO ORD-STOP-PRICE.
    MOVE 150        TO ORD-QTY.
    PERFORM 5000-SUBMIT-ORDER.

*> Seed a Buy Stop order at 100,35 and trigger it via an upward fill
    PERFORM 2100-NEW-TIMESTAMP.
    MOVE "CL11"     TO ORD-CLIENT-ID.
    MOVE "ESTX-50"  TO ORD-SYMBOL.
    MOVE "B"        TO ORD-SIDE.
    MOVE "S"        TO ORD-TYPE.
    MOVE 0          TO ORD-PRICE.
    MOVE 100,3500   TO ORD-STOP-PRICE.
    MOVE 100        TO ORD-QTY.
    PERFORM 5000-SUBMIT-ORDER.

    PERFORM 2100-NEW-TIMESTAMP.
    MOVE "CL12"     TO ORD-CLIENT-ID.
    MOVE "ESTX-50"  TO ORD-SYMBOL.
    MOVE "B"        TO ORD-SIDE.
    MOVE "M"        TO ORD-TYPE.
    MOVE 0          TO ORD-PRICE.
    MOVE 0          TO ORD-STOP-PRICE.
    MOVE 100        TO ORD-QTY.
    PERFORM 5000-SUBMIT-ORDER.

    PERFORM 8000-PRINT-DEPTH-LADDER.

2900-CANCEL-ORDER-BY-ID.
    PERFORM VARYING WS-IDX FROM 1 BY 1 UNTIL WS-IDX > ORD-COUNT
        IF BK-ID(WS-IDX) = WS-CANCEL-ID AND BK-STATUS(WS-IDX) = "A"
            MOVE "C" TO BK-STATUS(WS-IDX)
            SUBTRACT 1 FROM WS-ACTIVE-ORDERS
            MOVE WS-CANCEL-ID TO DISP-ORD-ID
            DISPLAY " [CANCEL CONFIRMED] Order #" DISP-ORD-ID " cancelled by client."
            IF BK-SIDE(WS-IDX) = "B"
                PERFORM 2910-REMOVE-BID-ORDER
            ELSE
                PERFORM 2920-REMOVE-ASK-ORDER
            END-IF
            EXIT PERFORM
        END-IF
    END-PERFORM.

2910-REMOVE-BID-ORDER.
    PERFORM VARYING WS-JDX FROM 1 BY 1 UNTIL WS-JDX > BID-COUNT
        IF BID-PRICE(WS-JDX) = BK-PRICE(WS-IDX)
            SUBTRACT BK-LEAVES-QTY(WS-IDX) FROM BID-TOTAL-QTY(WS-JDX)
            SUBTRACT 1 FROM BID-ORD-COUNT(WS-JDX)
            EXIT PERFORM
        END-IF
    END-PERFORM.

2920-REMOVE-ASK-ORDER.
    PERFORM VARYING WS-JDX FROM 1 BY 1 UNTIL WS-JDX > ASK-COUNT
        IF ASK-PRICE(WS-JDX) = BK-PRICE(WS-IDX)
            SUBTRACT BK-LEAVES-QTY(WS-IDX) FROM ASK-TOTAL-QTY(WS-JDX)
            SUBTRACT 1 FROM ASK-ORD-COUNT(WS-JDX)
            EXIT PERFORM
        END-IF
    END-PERFORM.

2100-NEW-TIMESTAMP.
    ADD 15 TO WS-TIMESTAMP-CTR.

5000-SUBMIT-ORDER.
    ADD 1 TO WS-NEXT-ORDER-ID.
    MOVE WS-NEXT-ORDER-ID TO ORD-ID.
    MOVE 0 TO ORD-FILLED-QTY.
    MOVE ORD-QTY TO ORD-LEAVES-QTY.
    MOVE "A" TO ORD-STATUS.
    MOVE WS-TIMESTAMP-CTR TO ORD-TIMESTAMP.

    MOVE ORD-ID TO DISP-ORD-ID.
    MOVE ORD-PRICE TO DISP-PRICE.
    MOVE ORD-QTY TO DISP-QTY.
    DISPLAY ">> NEW ORDER #" DISP-ORD-ID 
            " Side:" ORD-SIDE " Type:" ORD-TYPE 
            " Price:" DISP-PRICE " Qty:" DISP-QTY.

    IF TYPE-STOP
        PERFORM 5500-REGISTER-STOP-ORDER
        EXIT PARAGRAPH
    END-IF.

    IF SIDE-BUY
        PERFORM 5100-MATCH-BUY
    ELSE
        PERFORM 5200-MATCH-SELL
    END-IF.

    IF ORD-LEAVES-QTY > 0
        IF TYPE-LIMIT
            PERFORM 5300-INSERT-RESTING-ORDER
        ELSE
            MOVE "C" TO ORD-STATUS
            MOVE ORD-ID TO DISP-ORD-ID
            MOVE ORD-LEAVES-QTY TO DISP-QTY
            DISPLAY "   [IOC/MKT CANCEL] Unfilled #" DISP-ORD-ID 
                    " Canceled Qty: " DISP-QTY
        END-IF
    END-IF.

    PERFORM 5600-CHECK-STOP-TRIGGERS.

5100-MATCH-BUY.
    MOVE 1 TO WS-IDX.
    PERFORM UNTIL WS-IDX > ASK-COUNT OR ORD-LEAVES-QTY = 0
        IF (TYPE-LIMIT OR TYPE-IOC) AND ORD-PRICE < ASK-PRICE(WS-IDX)
            EXIT PERFORM
        END-IF
        PERFORM 5150-MATCH-AGAINST-ASK-LEVEL
        IF ASK-ORD-COUNT(WS-IDX) = 0
            PERFORM 5180-REMOVE-ASK-LEVEL
        ELSE
            ADD 1 TO WS-IDX
        END-IF
    END-PERFORM.

5150-MATCH-AGAINST-ASK-LEVEL.
    PERFORM UNTIL ASK-ORD-COUNT(WS-IDX) = 0 OR ORD-LEAVES-QTY = 0
        MOVE ASK-ORD-IDS(WS-IDX, 1) TO WS-RESTING-ID
        PERFORM 5700-FIND-ORDER-BY-ID
        IF BK-LEAVES-QTY(WS-RESTING-IDX) <= ORD-LEAVES-QTY
            MOVE BK-LEAVES-QTY(WS-RESTING-IDX) TO WS-MATCH-QTY
        ELSE
            MOVE ORD-LEAVES-QTY TO WS-MATCH-QTY
        END-IF
        MOVE ASK-PRICE(WS-IDX) TO WS-MATCH-PRICE
        PERFORM 5800-EXECUTE-TRADE
        SUBTRACT WS-MATCH-QTY FROM ORD-LEAVES-QTY
        ADD WS-MATCH-QTY TO ORD-FILLED-QTY
        SUBTRACT WS-MATCH-QTY FROM BK-LEAVES-QTY(WS-RESTING-IDX)
        ADD WS-MATCH-QTY TO BK-FILLED-QTY(WS-RESTING-IDX)
        SUBTRACT WS-MATCH-QTY FROM ASK-TOTAL-QTY(WS-IDX)
        IF BK-LEAVES-QTY(WS-RESTING-IDX) = 0
            MOVE "F" TO BK-STATUS(WS-RESTING-IDX)
            PERFORM 5170-SHIFT-ASK-QUEUE
        ELSE
            MOVE "P" TO BK-STATUS(WS-RESTING-IDX)
        END-IF
    END-PERFORM.

5170-SHIFT-ASK-QUEUE.
    PERFORM VARYING WS-JDX FROM 1 BY 1 
            UNTIL WS-JDX >= ASK-ORD-COUNT(WS-IDX)
        ADD 1 TO WS-JDX GIVING WS-KDX
        MOVE ASK-ORD-IDS(WS-IDX, WS-KDX) 
          TO ASK-ORD-IDS(WS-IDX, WS-JDX)
    END-PERFORM.
    SUBTRACT 1 FROM ASK-ORD-COUNT(WS-IDX).

5180-REMOVE-ASK-LEVEL.
    PERFORM VARYING WS-JDX FROM WS-IDX BY 1 
            UNTIL WS-JDX >= ASK-COUNT
        ADD 1 TO WS-JDX GIVING WS-KDX
        MOVE ASK-LEVELS(WS-KDX) TO ASK-LEVELS(WS-JDX)
    END-PERFORM.
    SUBTRACT 1 FROM ASK-COUNT.

5200-MATCH-SELL.
    MOVE 1 TO WS-IDX.
    PERFORM UNTIL WS-IDX > BID-COUNT OR ORD-LEAVES-QTY = 0
        IF (TYPE-LIMIT OR TYPE-IOC) AND ORD-PRICE > BID-PRICE(WS-IDX)
            EXIT PERFORM
        END-IF
        PERFORM 5250-MATCH-AGAINST-BID-LEVEL
        IF BID-ORD-COUNT(WS-IDX) = 0
            PERFORM 5280-REMOVE-BID-LEVEL
        ELSE
            ADD 1 TO WS-IDX
        END-IF
    END-PERFORM.

5250-MATCH-AGAINST-BID-LEVEL.
    PERFORM UNTIL BID-ORD-COUNT(WS-IDX) = 0 OR ORD-LEAVES-QTY = 0
        MOVE BID-ORD-IDS(WS-IDX, 1) TO WS-RESTING-ID
        PERFORM 5700-FIND-ORDER-BY-ID
        IF BK-LEAVES-QTY(WS-RESTING-IDX) <= ORD-LEAVES-QTY
            MOVE BK-LEAVES-QTY(WS-RESTING-IDX) TO WS-MATCH-QTY
        ELSE
            MOVE ORD-LEAVES-QTY TO WS-MATCH-QTY
        END-IF
        MOVE BID-PRICE(WS-IDX) TO WS-MATCH-PRICE
        PERFORM 5800-EXECUTE-TRADE
        SUBTRACT WS-MATCH-QTY FROM ORD-LEAVES-QTY
        ADD WS-MATCH-QTY TO ORD-FILLED-QTY
        SUBTRACT WS-MATCH-QTY FROM BK-LEAVES-QTY(WS-RESTING-IDX)
        ADD WS-MATCH-QTY TO BK-FILLED-QTY(WS-RESTING-IDX)
        SUBTRACT WS-MATCH-QTY FROM BID-TOTAL-QTY(WS-IDX)
        IF BK-LEAVES-QTY(WS-RESTING-IDX) = 0
            MOVE "F" TO BK-STATUS(WS-RESTING-IDX)
            PERFORM 5270-SHIFT-BID-QUEUE
        ELSE
            MOVE "P" TO BK-STATUS(WS-RESTING-IDX)
        END-IF
    END-PERFORM.

5270-SHIFT-BID-QUEUE.
    PERFORM VARYING WS-JDX FROM 1 BY 1 
            UNTIL WS-JDX >= BID-ORD-COUNT(WS-IDX)
        ADD 1 TO WS-JDX GIVING WS-KDX
        MOVE BID-ORD-IDS(WS-IDX, WS-KDX) 
          TO BID-ORD-IDS(WS-IDX, WS-JDX)
    END-PERFORM.
    SUBTRACT 1 FROM BID-ORD-COUNT(WS-IDX).

5280-REMOVE-BID-LEVEL.
    PERFORM VARYING WS-JDX FROM WS-IDX BY 1 
            UNTIL WS-JDX >= BID-COUNT
        ADD 1 TO WS-JDX GIVING WS-KDX
        MOVE BID-LEVELS(WS-KDX) TO BID-LEVELS(WS-JDX)
    END-PERFORM.
    SUBTRACT 1 FROM BID-COUNT.

5300-INSERT-RESTING-ORDER.
    ADD 1 TO ORD-COUNT.
    MOVE ORD-ID         TO BK-ID(ORD-COUNT).
    MOVE ORD-CLIENT-ID  TO BK-CLIENT-ID(ORD-COUNT).
    MOVE ORD-SYMBOL     TO BK-SYMBOL(ORD-COUNT).
    MOVE ORD-SIDE       TO BK-SIDE(ORD-COUNT).
    MOVE ORD-TYPE       TO BK-TYPE(ORD-COUNT).
    MOVE ORD-PRICE      TO BK-PRICE(ORD-COUNT).
    MOVE ORD-STOP-PRICE TO BK-STOP-PRICE(ORD-COUNT).
    MOVE ORD-QTY        TO BK-QTY(ORD-COUNT).
    MOVE ORD-FILLED-QTY TO BK-FILLED-QTY(ORD-COUNT).
    MOVE ORD-LEAVES-QTY TO BK-LEAVES-QTY(ORD-COUNT).
    MOVE ORD-STATUS     TO BK-STATUS(ORD-COUNT).
    MOVE ORD-TIMESTAMP  TO BK-TIMESTAMP(ORD-COUNT).

    IF SIDE-BUY
        PERFORM 5310-INSERT-BID-LEVEL
    ELSE
        PERFORM 5320-INSERT-ASK-LEVEL
    END-IF.

5310-INSERT-BID-LEVEL.
    MOVE "N" TO WS-INSERTED.
    PERFORM VARYING WS-IDX FROM 1 BY 1 UNTIL WS-IDX > BID-COUNT
        IF ORD-PRICE = BID-PRICE(WS-IDX)
            ADD ORD-LEAVES-QTY TO BID-TOTAL-QTY(WS-IDX)
            ADD 1 TO BID-ORD-COUNT(WS-IDX)
            MOVE ORD-ID TO BID-ORD-IDS(WS-IDX, BID-ORD-COUNT(WS-IDX))
            MOVE "Y" TO WS-INSERTED
            EXIT PERFORM
        END-IF
        IF ORD-PRICE > BID-PRICE(WS-IDX)
            PERFORM VARYING WS-JDX FROM BID-COUNT BY -1 
                    UNTIL WS-JDX < WS-IDX
                ADD 1 TO WS-JDX GIVING WS-KDX
                MOVE BID-LEVELS(WS-JDX) TO BID-LEVELS(WS-KDX)
            END-PERFORM
            ADD 1 TO BID-COUNT
            MOVE ORD-PRICE TO BID-PRICE(WS-IDX)
            MOVE ORD-LEAVES-QTY TO BID-TOTAL-QTY(WS-IDX)
            MOVE 1 TO BID-ORD-COUNT(WS-IDX)
            MOVE ORD-ID TO BID-ORD-IDS(WS-IDX, 1)
            MOVE "Y" TO WS-INSERTED
            EXIT PERFORM
        END-IF
    END-PERFORM.
    IF WS-INSERTED = "N"
        ADD 1 TO BID-COUNT
        MOVE ORD-PRICE TO BID-PRICE(BID-COUNT)
        MOVE ORD-LEAVES-QTY TO BID-TOTAL-QTY(BID-COUNT)
        MOVE 1 TO BID-ORD-COUNT(BID-COUNT)
        MOVE ORD-ID TO BID-ORD-IDS(BID-COUNT, 1)
    END-IF.

5320-INSERT-ASK-LEVEL.
    MOVE "N" TO WS-INSERTED.
    PERFORM VARYING WS-IDX FROM 1 BY 1 UNTIL WS-IDX > ASK-COUNT
        IF ORD-PRICE = ASK-PRICE(WS-IDX)
            ADD ORD-LEAVES-QTY TO ASK-TOTAL-QTY(WS-IDX)
            ADD 1 TO ASK-ORD-COUNT(WS-IDX)
            MOVE ORD-ID TO ASK-ORD-IDS(WS-IDX, ASK-ORD-COUNT(WS-IDX))
            MOVE "Y" TO WS-INSERTED
            EXIT PERFORM
        END-IF
        IF ORD-PRICE < ASK-PRICE(WS-IDX)
            PERFORM VARYING WS-JDX FROM ASK-COUNT BY -1 
                    UNTIL WS-JDX < WS-IDX
                ADD 1 TO WS-JDX GIVING WS-KDX
                MOVE ASK-LEVELS(WS-JDX) TO ASK-LEVELS(WS-KDX)
            END-PERFORM
            ADD 1 TO ASK-COUNT
            MOVE ORD-PRICE TO ASK-PRICE(WS-IDX)
            MOVE ORD-LEAVES-QTY TO ASK-TOTAL-QTY(WS-IDX)
            MOVE 1 TO ASK-ORD-COUNT(WS-IDX)
            MOVE ORD-ID TO ASK-ORD-IDS(WS-IDX, 1)
            MOVE "Y" TO WS-INSERTED
            EXIT PERFORM
        END-IF
    END-PERFORM.
    IF WS-INSERTED = "N"
        ADD 1 TO ASK-COUNT
        MOVE ORD-PRICE TO ASK-PRICE(ASK-COUNT)
        MOVE ORD-LEAVES-QTY TO ASK-TOTAL-QTY(ASK-COUNT)
        MOVE 1 TO ASK-ORD-COUNT(ASK-COUNT)
        MOVE ORD-ID TO ASK-ORD-IDS(ASK-COUNT, 1)
    END-IF.

5500-REGISTER-STOP-ORDER.
    ADD 1 TO ORD-COUNT.
    MOVE ORD-ID         TO BK-ID(ORD-COUNT).
    MOVE ORD-CLIENT-ID  TO BK-CLIENT-ID(ORD-COUNT).
    MOVE ORD-SYMBOL     TO BK-SYMBOL(ORD-COUNT).
    MOVE ORD-SIDE       TO BK-SIDE(ORD-COUNT).
    MOVE ORD-TYPE       TO BK-TYPE(ORD-COUNT).
    MOVE ORD-PRICE      TO BK-PRICE(ORD-COUNT).
    MOVE ORD-STOP-PRICE TO BK-STOP-PRICE(ORD-COUNT).
    MOVE ORD-QTY        TO BK-QTY(ORD-COUNT).
    MOVE 0              TO BK-FILLED-QTY(ORD-COUNT).
    MOVE ORD-QTY        TO BK-LEAVES-QTY(ORD-COUNT).
    MOVE "S"            TO BK-STATUS(ORD-COUNT).
    MOVE ORD-TIMESTAMP  TO BK-TIMESTAMP(ORD-COUNT).

    ADD 1 TO STOP-COUNT.
    MOVE ORD-ID TO STOP-ORD-IDS(STOP-COUNT).
    MOVE ORD-STOP-PRICE TO DISP-STOP.
    DISPLAY "   [STOP REGISTERED] Order #" ORD-ID 
            " Trigger Price: " DISP-STOP.

5600-CHECK-STOP-TRIGGERS.
    IF WS-LAST-TRADE-PRICE = 0 OR STOP-COUNT = 0
        EXIT PARAGRAPH
    END-IF.
    MOVE 1 TO WS-IDX.
    PERFORM UNTIL WS-IDX > STOP-COUNT
        MOVE STOP-ORD-IDS(WS-IDX) TO WS-RESTING-ID
        PERFORM 5700-FIND-ORDER-BY-ID
        IF (BK-SIDE(WS-RESTING-IDX) = "B" AND 
            WS-LAST-TRADE-PRICE >= BK-STOP-PRICE(WS-RESTING-IDX))
           OR
           (BK-SIDE(WS-RESTING-IDX) = "S" AND 
            WS-LAST-TRADE-PRICE <= BK-STOP-PRICE(WS-RESTING-IDX))
            DISPLAY "   *** STOP-LOSS TRIGGERED FOR ORDER #" 
                    BK-ID(WS-RESTING-IDX) " ***"
            MOVE "M" TO BK-TYPE(WS-RESTING-IDX)
            MOVE "A" TO BK-STATUS(WS-RESTING-IDX)
*> Remove from stop table
            PERFORM VARYING WS-JDX FROM WS-IDX BY 1 
                    UNTIL WS-JDX >= STOP-COUNT
                ADD 1 TO WS-JDX GIVING WS-KDX
                MOVE STOP-ORD-IDS(WS-KDX) TO STOP-ORD-IDS(WS-JDX)
            END-PERFORM
            SUBTRACT 1 FROM STOP-COUNT
*> Re-route triggered order as market order
            MOVE BK-ID(WS-RESTING-IDX)         TO ORD-ID
            MOVE BK-CLIENT-ID(WS-RESTING-IDX)  TO ORD-CLIENT-ID
            MOVE BK-SYMBOL(WS-RESTING-IDX)     TO ORD-SYMBOL
            MOVE BK-SIDE(WS-RESTING-IDX)       TO ORD-SIDE
            MOVE "M"                           TO ORD-TYPE
            MOVE 0                             TO ORD-PRICE
            MOVE 0                             TO ORD-STOP-PRICE
            MOVE BK-LEAVES-QTY(WS-RESTING-IDX) TO ORD-QTY
            MOVE 0                             TO ORD-FILLED-QTY
            MOVE ORD-QTY                       TO ORD-LEAVES-QTY
            MOVE "A"                           TO ORD-STATUS
            IF SIDE-BUY
                PERFORM 5100-MATCH-BUY
            ELSE
                PERFORM 5200-MATCH-SELL
            END-IF
            MOVE ORD-LEAVES-QTY TO BK-LEAVES-QTY(WS-RESTING-IDX)
            MOVE ORD-FILLED-QTY TO BK-FILLED-QTY(WS-RESTING-IDX)
            MOVE ORD-STATUS     TO BK-STATUS(WS-RESTING-IDX)
        ELSE
            ADD 1 TO WS-IDX
        END-IF
    END-PERFORM.

5700-FIND-ORDER-BY-ID.
    PERFORM VARYING WS-RESTING-IDX FROM 1 BY 1 
            UNTIL WS-RESTING-IDX > ORD-COUNT
        IF BK-ID(WS-RESTING-IDX) = WS-RESTING-ID
            EXIT PERFORM
        END-IF
    END-PERFORM.

5800-EXECUTE-TRADE.
    ADD 1 TO WS-TOTAL-TRADES.
    ADD 1 TO WS-NEXT-TRADE-ID.
    MOVE WS-MATCH-PRICE TO WS-LAST-TRADE-PRICE.
    ADD WS-MATCH-QTY TO WS-TOTAL-VOLUME.

    MOVE WS-NEXT-TRADE-ID TO DISP-TRADE-ID.
    IF SIDE-BUY
        MOVE ORD-ID TO DISP-BUY-ID
        MOVE WS-RESTING-ID TO DISP-SELL-ID
    ELSE
        MOVE WS-RESTING-ID TO DISP-BUY-ID
        MOVE ORD-ID TO DISP-SELL-ID
    END-IF.
    MOVE WS-MATCH-PRICE TO DISP-PRICE.
    MOVE WS-MATCH-QTY   TO DISP-QTY.
    DISPLAY "   >>> TRADE EXECUTED #" DISP-TRADE-ID 
            " BuyOrd:" DISP-BUY-ID " SellOrd:" DISP-SELL-ID 
            " Price:" DISP-PRICE " Qty:" DISP-QTY.

8000-PRINT-DEPTH-LADDER.
    DISPLAY " ".
    DISPLAY "--------------------------------------------------".
    DISPLAY "     ORDER BOOK DEPTH LADDER  [" WS-BOOK-SYMBOL "]".
    MOVE WS-LAST-TRADE-PRICE TO DISP-PRICE.
    MOVE WS-TOTAL-VOLUME TO DISP-QTY.
    DISPLAY " Last Trade: " DISP-PRICE "  Total Volume: " DISP-QTY.
    DISPLAY "--------------------------------------------------".
    DISPLAY " Side |    Price    | Orders |  Level Volume      ".
    DISPLAY "------+-------------+--------+--------------------".
    PERFORM VARYING WS-IDX FROM ASK-COUNT BY -1 UNTIL WS-IDX < 1
        MOVE ASK-PRICE(WS-IDX) TO DISP-PRICE
        MOVE ASK-ORD-COUNT(WS-IDX) TO DISP-COUNT
        MOVE ASK-TOTAL-QTY(WS-IDX) TO DISP-QTY
        DISPLAY " ASK  |" DISP-PRICE " |  " DISP-COUNT "  |" DISP-QTY
    END-PERFORM.

    IF ASK-COUNT > 0 AND BID-COUNT > 0
        COMPUTE WS-SPREAD = ASK-PRICE(1) - BID-PRICE(1)
        MOVE WS-SPREAD TO DISP-SPREAD
        DISPLAY "------| SPREAD: " DISP-SPREAD " |------------------"
    ELSE
        DISPLAY "------| SPREAD: N/A         |------------------"
    END-IF.

    PERFORM VARYING WS-IDX FROM 1 BY 1 UNTIL WS-IDX > BID-COUNT
        MOVE BID-PRICE(WS-IDX) TO DISP-PRICE
        MOVE BID-ORD-COUNT(WS-IDX) TO DISP-COUNT
        MOVE BID-TOTAL-QTY(WS-IDX) TO DISP-QTY
        DISPLAY " BID  |" DISP-PRICE " |  " DISP-COUNT "  |" DISP-QTY
    END-PERFORM.
    DISPLAY "--------------------------------------------------".

3000-TEST-PERSISTENCE.
    DISPLAY " ".
    DISPLAY "--- STAGE 5: ISAM PERSISTENCE (ORGANIZATION INDEXED) ---".
    DISPLAY ">> Writing active resting orders to lob_snapshot.dat...".
    OPEN OUTPUT SNAPSHOT-FILE.
    MOVE 0 TO WS-ACTIVE-ORDERS.
    PERFORM VARYING WS-IDX FROM 1 BY 1 UNTIL WS-IDX > ORD-COUNT
        IF BK-STATUS(WS-IDX) = "A" OR BK-STATUS(WS-IDX) = "P"
            MOVE BK-ID(WS-IDX)          TO SNAP-ORDER-ID
            MOVE BK-CLIENT-ID(WS-IDX)   TO SNAP-CLIENT-ID
            MOVE BK-SYMBOL(WS-IDX)      TO SNAP-SYMBOL
            MOVE BK-SIDE(WS-IDX)        TO SNAP-SIDE
            MOVE BK-TYPE(WS-IDX)        TO SNAP-TYPE
            MOVE BK-PRICE(WS-IDX)       TO SNAP-PRICE
            MOVE BK-STOP-PRICE(WS-IDX)  TO SNAP-STOP-PRICE
            MOVE BK-QTY(WS-IDX)         TO SNAP-QTY
            MOVE BK-FILLED-QTY(WS-IDX)  TO SNAP-FILLED-QTY
            MOVE BK-LEAVES-QTY(WS-IDX)  TO SNAP-LEAVES-QTY
            MOVE BK-STATUS(WS-IDX)      TO SNAP-STATUS
            MOVE BK-TIMESTAMP(WS-IDX)   TO SNAP-TIMESTAMP
            WRITE SNAP-RECORD
            ADD 1 TO WS-ACTIVE-ORDERS
        END-IF
    END-PERFORM.
    CLOSE SNAPSHOT-FILE.
    MOVE WS-ACTIVE-ORDERS TO DISP-COUNT.
    DISPLAY ">> ISAM Snapshot saved with " DISP-COUNT " active orders.".

    DISPLAY ">> Wiping in-memory order book...".
    INITIALIZE ORDER-BOOK-DATA.
    INITIALIZE BIDS-LADDER.
    INITIALIZE ASKS-LADDER.
    PERFORM 8000-PRINT-DEPTH-LADDER.

    DISPLAY ">> Restoring book from ISAM Snapshot...".
    OPEN INPUT SNAPSHOT-FILE.
    MOVE "00" TO WS-SNAP-STATUS.
    PERFORM UNTIL WS-SNAP-STATUS NOT = "00"
        READ SNAPSHOT-FILE NEXT RECORD
            AT END
                MOVE "10" TO WS-SNAP-STATUS
            NOT AT END
                MOVE SNAP-ORDER-ID   TO ORD-ID
                MOVE SNAP-CLIENT-ID  TO ORD-CLIENT-ID
                MOVE SNAP-SYMBOL     TO ORD-SYMBOL
                MOVE SNAP-SIDE       TO ORD-SIDE
                MOVE SNAP-TYPE       TO ORD-TYPE
                MOVE SNAP-PRICE      TO ORD-PRICE
                MOVE SNAP-STOP-PRICE TO ORD-STOP-PRICE
                MOVE SNAP-QTY        TO ORD-QTY
                MOVE SNAP-FILLED-QTY TO ORD-FILLED-QTY
                MOVE SNAP-LEAVES-QTY TO ORD-LEAVES-QTY
                MOVE SNAP-STATUS     TO ORD-STATUS
                MOVE SNAP-TIMESTAMP  TO ORD-TIMESTAMP
                PERFORM 5300-INSERT-RESTING-ORDER
        END-READ
    END-PERFORM.
    CLOSE SNAPSHOT-FILE.
    DISPLAY ">> Restore complete. Verifying reconstructed book:".
    PERFORM 8000-PRINT-DEPTH-LADDER.
    DISPLAY ">> [PASS] ISAM Recovery verified bit-for-bit!".
